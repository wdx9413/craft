{
  "name": "craft-agent-harness",
  "version": "0.12.18",
  "description": "Cross-platform capability, workflow, evidence, and agent harness",
  "type": "module",
  "bin": {
    "craft": "dist/src/cli.js",
    "craft-mcp": "dist/bin/craft-mcp.js",
    "craft-mcp-full": "dist/bin/craft-mcp-full.js"
  },
  "scripts": {
    "test": "pnpm run build && pnpm run typecheck && pnpm run test:ts && pnpm run test:v01216 && pnpm run test:v01217 && pnpm run test:v01218 && pnpm run test:smoke && pnpm run test:plugin",
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "build": "pnpm run clean && pnpm run build:core && pnpm run build:plugin && pnpm run pack:plugin && pnpm run build:deepseek && pnpm run pack:adapters",
    "build:core": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:plugin": "esbuild bin/craft-mcp.ts --bundle --platform=node --format=cjs --target=node23 --outfile=dist/plugin/craft-mcp.cjs && esbuild bin/craft-mcp-full.ts --bundle --platform=node --format=cjs --target=node23 --outfile=dist/plugin/craft-mcp-full.cjs",
    "pack:plugin": "node --experimental-strip-types scripts/pack-plugin.ts",
    "build:deepseek": "node node_modules/typescript/bin/tsc -p adapters/deepseek-harness/tsconfig.json",
    "pack:adapters": "node --experimental-strip-types scripts/pack-adapters.ts",
    "pack:desktop": "node --experimental-strip-types scripts/package-desktop.ts",
    "prepack": "pnpm run build",
    "test:smoke": "node dist/src/cli.js --help",
    "test:plugin": "node --experimental-strip-types scripts/check-plugin-package.ts && node --experimental-strip-types scripts/plugin-smoke.ts && node --experimental-strip-types scripts/plugin-full-smoke.ts",
    "version:check": "node --experimental-strip-types scripts/check-version.ts",
    "test:ts": "pnpm run version:check && node --experimental-strip-types scripts/test.ts",
    "test:v01216": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=src/federated-delegation.ts --test-coverage-include=src/harness-topology.ts --test-coverage-include=src/runtime-readiness.ts --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/v01216-federated-runtime.test.ts",
    "test:v01217": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=src/assured-pilot.ts --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/v01217-assured-pilot.test.ts",
    "test:v01218": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=src/capability-kit-runtime.ts --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/v01218-capability-platform.test.ts",
    "check:ts": "node --experimental-strip-types src/cli.ts --help",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=23"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "skills",
    "adapters",
    "plugins/craft",
    ".claude-plugin",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "agent",
    "mcp",
    "skills",
    "workflow",
    "harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": ">=23 <26",
    "esbuild": "^0.28.2",
    "typescript": ">=5.8 <7"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.19.0"
}
