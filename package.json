{
  "name": "craft",
  "version": "0.20.4",
  "description": "Cross-platform capability, workflow, evidence, and agent harness",
  "type": "module",
  "bin": {
    "craft": "dist/core/cli.js",
    "craft-mcp": "dist/bin/craft-mcp.js",
    "craft-mcp-full": "dist/bin/craft-mcp-full.js",
    "craft-mcp-http": "dist/bin/craft-mcp-http.js",
    "craft-experience-learning-worker": "dist/plugin/craft-experience-learning-worker.js",
    "craft-continuous-learning-worker": "dist/plugin/craft-experience-learning-worker.js"
  },
  "scripts": {
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "build": "pnpm run clean && pnpm run build:core && pnpm run build:common && pnpm run build:plugin && pnpm run build:datasec && pnpm run build:deepseek && pnpm run pack:plugin",
    "build:datasec": "node --experimental-strip-types capability/craft-datasec/build.ts",
    "build:core": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:plugin": "node --experimental-strip-types scripts/release/prepare-typescript-compiler.ts && esbuild bin/craft-mcp.ts --bundle --define:CRAFT_TYPESCRIPT_BUNDLE=true --platform=node --format=cjs --target=node23 --define:import.meta.url=undefined --outfile=dist/plugin/craft-mcp.cjs && esbuild bin/craft-mcp-full.ts --bundle --define:CRAFT_TYPESCRIPT_BUNDLE=true --platform=node --format=cjs --target=node23 --define:import.meta.url=undefined --outfile=dist/plugin/craft-mcp-full.cjs && esbuild bin/craft-mcp-http.ts --bundle --define:CRAFT_TYPESCRIPT_BUNDLE=true --platform=node --format=cjs --target=node23 --define:import.meta.url=undefined --outfile=dist/plugin/craft-mcp-http.cjs && esbuild bin/craft-codex-hook.ts --bundle --define:CRAFT_TYPESCRIPT_BUNDLE=true --platform=node --format=cjs --target=node23 --define:import.meta.url=undefined --outfile=dist/plugin/craft-codex-hook.cjs && esbuild bin/craft-parser-worker.ts --bundle --define:CRAFT_TYPESCRIPT_BUNDLE=true --platform=node --format=esm --target=node23 --outfile=dist/plugin/craft-parser-worker.js && esbuild deploy/experience-learning/worker.ts --bundle --define:CRAFT_TYPESCRIPT_BUNDLE=true --platform=node --format=esm --target=node23 --outfile=dist/plugin/craft-experience-learning-worker.js",
    "pack:plugin": "node --experimental-strip-types scripts/release/pack-plugin.ts",
    "release:sync": "node --experimental-strip-types scripts/release/sync-release-catalog.ts",
    "release:check": "node --experimental-strip-types scripts/release/check-release-catalog.ts",
    "prepack": "pnpm run build",
    "test": "pnpm run build && pnpm run typecheck && pnpm run audit:layering && pnpm run audit:surfaces && pnpm run audit:docs && pnpm run audit:consistency && pnpm run test:ts && pnpm run test:coverage-gates && pnpm run test:smoke && pnpm run test:plugin",
    "test:ts": "pnpm run version:check && node --experimental-strip-types scripts/ci/test.ts",
    "test:coverage-gates": "node --experimental-strip-types scripts/coverage/coverage-gates.ts && pnpm run test:experience-learning-worker-coverage && pnpm run test:coverage:context-response",
    "test:coverage-gates:list": "node --experimental-strip-types scripts/coverage/coverage-gates.ts --list",
    "test:coverage-gates:one": "node --experimental-strip-types scripts/coverage/coverage-gates.ts --group",
    "test:coverage:context-response": "node --experimental-strip-types --test --test-isolation=none --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=core/context-response-projection.ts tests/context-response-projection.test.ts",
    "test:coverage:workbench-context-audit": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=core/workbench-context-audit.ts --test-coverage-include=core/interfaces/workbench-context-audit-route.ts tests/workbench-context-audit.test.ts tests/workbench-context-audit-route.test.ts",
    "test:coverage:hook-diagnostics": "c8 --clean --reporter=text --include=core/interfaces/codex-hook-runtime-diagnostics.ts --include=core/interfaces/hook-runtime-query.ts --check-coverage --lines 100 --branches 100 --functions 100 node --experimental-strip-types --test --test-isolation=none tests/codex-hook-runtime-diagnostics.test.ts",
    "test:experience-learning-worker-coverage": "c8 --reporter=text --include=deploy/experience-learning/worker.ts --check-coverage --branches 100 --lines 100 --functions 100 node --test --test-concurrency=1 tests/experience-learning-worker.test.ts",
    "audit:coverage-inventory": "node --experimental-strip-types scripts/coverage/check-coverage-inventory.ts",
    "test:smoke": "node dist/core/cli.js --help",
    "smoke:context-weight": "node --experimental-strip-types scripts/smoke/context-weight-loop-smoke.ts",
    "test:plugin": "pnpm run release:check && node --experimental-strip-types scripts/release/check-plugin-package.ts && node --experimental-strip-types scripts/release/check-plugin-version.ts && node --experimental-strip-types --test tests/codex-host-plugin-config.test.ts && node --experimental-strip-types scripts/smoke/plugin-smoke.ts && node --experimental-strip-types scripts/smoke/plugin-component-smoke.ts && node --experimental-strip-types scripts/smoke/experience-autoevolution-smoke.ts && node --experimental-strip-types scripts/smoke/plugin-full-smoke.ts",
    "version:check": "node --experimental-strip-types scripts/ci/check-version.ts",
    "audit:layering": "node --experimental-strip-types scripts/ci/audit-layering.ts",
    "audit:surfaces": "node --experimental-strip-types scripts/ci/audit-surfaces.ts",
    "audit:docs": "node --experimental-strip-types scripts/ci/check-doc-links.ts",
    "audit:architecture-integration": "node --experimental-strip-types scripts/ci/audit-capability-map.ts",
    "audit:consistency": "node --experimental-strip-types scripts/ci/check-consistency-falsifiable.ts",
    "audit:egress": "node --experimental-strip-types scripts/ci/audit-model-egress.ts",
    "eval": "node --experimental-strip-types capability/craft-eval/suite.ts",
    "eval:memory": "node --experimental-strip-types capability/craft-eval/suite.ts memory",
    "eval:knowledge": "node --experimental-strip-types capability/craft-eval/suite.ts knowledge",
    "eval:workflow": "node --experimental-strip-types capability/craft-eval/suite.ts workflow",
    "eval:datasec": "node --experimental-strip-types capability/craft-eval/suite.ts datasec",
    "eval:self-evolution": "node --test --test-concurrency=1 tests/self-evolution-regression.test.ts",
    "experience:worker": "node --experimental-strip-types deploy/experience-learning/worker.ts",
    "learning:worker": "node --experimental-strip-types deploy/experience-learning/worker.ts",
    "eval:end-to-end": "node --experimental-strip-types capability/craft-eval/suite.ts end_to_end",
    "eval:governance": "node --experimental-strip-types capability/craft-eval/suite.ts governance",
    "eval:abstraction": "node --experimental-strip-types capability/craft-eval/abstraction.ts",
    "eval:codebase-retrieval": "node --experimental-strip-types scripts/eval/codebase-retrieval-evaluation.ts",
    "benchmark:codebase-incremental": "node --experimental-strip-types scripts/smoke/codebase-incremental-self-index.ts",
    "eval:live": "node --experimental-strip-types capability/craft-eval/run.ts && node --experimental-strip-types capability/craft-eval/recurrence.ts && node --experimental-strip-types capability/craft-eval/suite.ts",
    "eval:local": "node --import ./scripts/dev/load-env.ts --experimental-strip-types capability/craft-eval/suite.ts",
    "eval:compare": "node --experimental-strip-types capability/craft-eval/compare.ts",
    "eval:local:live": "node --import ./scripts/dev/load-env.ts --experimental-strip-types capability/craft-eval/run.ts && node --import ./scripts/dev/load-env.ts --experimental-strip-types capability/craft-eval/recurrence.ts && node --import ./scripts/dev/load-env.ts --experimental-strip-types capability/craft-eval/suite.ts",
    "e2e": "node --import ./scripts/dev/load-env.ts --experimental-strip-types --test --test-isolation=none --test-concurrency=1 tests/e2e-governed-loop.test.ts",
    "engineering:eval": "node --experimental-strip-types scripts/engineering-eval.ts",
    "coverage:branches:report": "c8 --all --src=core --exclude=core/cli.ts --exclude=core/**/index.ts --exclude=**/*.d.ts --reporter=json --reporter=text --report-dir=coverage node --test --test-isolation=none --test-concurrency=1 tests/*.test.ts && node --experimental-strip-types scripts/branch-gap-report.ts",
    "knowledge:import-offline": "node --experimental-strip-types scripts/import-legacy-knowledge.ts",
    "check:ts": "node --experimental-strip-types core/cli.ts --help",
    "lint": "node --experimental-strip-types scripts/ci/lint.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build:common": "node --experimental-strip-types scripts/release/build-common-packages.ts",
    "build:deepseek": "node node_modules/typescript/bin/tsc -p adapters/deepseek-harness/tsconfig.json && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/adapters/deepseek-harness',{recursive:true}); fs.copyFileSync('adapters/deepseek-harness/package.json','dist/adapters/deepseek-harness/package.json')\"",
    "pack:adapters": "node --experimental-strip-types scripts/release/pack-adapters.ts",
    "eval:self-evolution:kernel": "node --experimental-strip-types -e \"import('./core/eval/self-evolution-regression.ts').then(m=>m.runSelfEvolutionRegression().then(r=>{console.log(JSON.stringify(r,null,2));process.exitCode=(r.failed||r.unobserved)?1:0}))\""
  },
  "engines": {
    "node": ">=23"
  },
  "files": [
    "bin",
    "core",
    "capability",
    "common",
    "dist/core",
    "dist/capability",
    "dist/common",
    "dist/bin",
    "dist/plugin",
    "dist/adapters",
    "skills",
    "adapters",
    "assets/ocr",
    "runtime-artifacts.json",
    "plugins",
    ".claude-plugin",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs",
    "deploy",
    "scripts/codebase",
    "scripts/eval"
  ],
  "keywords": [
    "agent",
    "mcp",
    "skills",
    "workflow",
    "harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": ">=23 <26",
    "c8": "10.1.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@anthropic-ai/sdk": "1.3.0",
    "@craft/capability-codebase": "0.20.4",
    "@craft/capability-experience": "0.20.4",
    "@craft/capability-knowledge": "0.20.4",
    "@craft/capability-memory": "0.20.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "craft-common-base": "0.20.4",
    "craft-common-log": "0.20.4",
    "craft-common-store-local": "0.20.4",
    "craft-eval": "file:vendor/craft-eval-0.7.2.tgz",
    "tesseract.js": "^7.0.0",
    "typescript": ">=5.8 <7",
    "yaml": "^2.9.0",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    "./package.json": "./package.json",
    "./runtime-artifacts.json": "./runtime-artifacts.json",
    "./runtime-artifact": "./dist/core/runtime-artifact.js",
    "./runtime": "./dist/core/runtime-api.js"
  },
  "craftRuntime": {
    "protocolVersion": 1
  }
}
