{
  "name": "craft-agent-harness",
  "version": "0.3.0",
  "description": "Cross-platform capability, workflow, evidence, and agent harness",
  "type": "module",
  "bin": {
    "craft": "dist/src/cli.js",
    "craft-mcp": "dist/bin/craft-mcp.js"
  },
  "scripts": {
    "test": "pnpm run build && pnpm run typecheck && pnpm run test:ts && pnpm run test:smoke && pnpm run test:plugin",
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "build": "pnpm run clean && pnpm run build:core && pnpm run build:plugin && pnpm run build:deepseek",
    "build:core": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:plugin": "node node_modules/esbuild/bin/esbuild bin/craft-mcp.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/plugin/craft-mcp.cjs",
    "build:deepseek": "node node_modules/typescript/bin/tsc -p adapters/deepseek-harness/tsconfig.json",
    "prepack": "pnpm run build",
    "test:smoke": "node dist/src/cli.js --help",
    "test:plugin": "node --experimental-strip-types scripts/plugin-smoke.ts",
    "test:ts": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/config.test.ts tests/store.test.ts tests/catalog.test.ts tests/workflow.test.ts tests/orchestration.test.ts tests/service.test.ts tests/mcp.test.ts",
    "check:ts": "node --experimental-strip-types src/cli.ts --help",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "skills",
    "adapters",
    ".codex-plugin",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "agent",
    "mcp",
    "skills",
    "workflow",
    "harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": ">=24 <26",
    "esbuild": "^0.28.2",
    "typescript": ">=5.8 <7"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
