{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["core/**/*.ts", "bin/**/*.ts", "scripts/owner-history-archive.ts", "scripts/owner-history-compress.ts", "scripts/owner-history-import.ts", "scripts/owner-storage-cutover.ts", "scripts/storage-capacity.ts"],
  "exclude": ["tests", "adapters"]
}
