.craft_data/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
# Python-era scaffolding from before the Node-only runtime; kept out of Git so a
# local copy cannot be mistaken for part of the product.
/br-tools/
tests/.tmp/
tests/.validation-deps/
.coverage
coverage.json
# c8's report directory is `coverage/` at the root of the ignored set, and the
# pattern below matches a directory of that name at any depth -- which also
# swallowed `scripts/coverage/`, where the gate code lives. It was therefore
# never committed, so a fresh clone had no way to run its own coverage gate.
coverage/
!scripts/coverage/
!scripts/coverage/**
htmlcov/
build/
/dist/
/adapters/deepseek-harness/dist/
.test-install/
node_modules/
.node-coverage/
.coverage-raw/
# Ad-hoc V8 dump directories and console dumps written while investigating
# coverage gaps (`--test-coverage-directory=cov-*`). Local scratch only.
cov-*/
.cov*.txt
.workbuddy/
.workbuddy-ai/
.tmp-*

# `pack-plugin` regenerates these from `dist/plugin` on every `pnpm build`, and a
# component plugin only needs them at runtime. The bundles were byte-identical
# copies (8 x 2.25 MB) and the skill files were copies of `skills/<name>`, so this
# kept 21.5 MB of duplicated build output in Git. Plugin metadata stays tracked:
# only the generated `dist/` and `skills/` trees are ignored.
/plugins/*/dist/
/plugins/*/skills/

# Tauri desktop shell. `desktop/scripts/prepare-sidecar.mjs` deletes and rebuilds
# `src-tauri/resources/app` from `dist/`, the Workbench sources, `assets/ocr` and a
# copy of the running Node executable on every dev and build run, and Cargo
# regenerates `src-tauri/target`. Together they were 6.6 GB of regenerable output,
# 88 MB of which is a single copied `node.exe`; none of it belongs in history. The
# app source, `Cargo.lock`, the capability scope and `tauri.conf.json` stay tracked,
# because the desktop contract test reads them. `gen/schemas` is Tauri-generated and
# its own template ignores it.
/desktop/src-tauri/target/
/desktop/src-tauri/resources/app/
/desktop/src-tauri/gen/schemas/

# Credentials. Craft can import a desktop credential file, so a stray `.env` or key
# in the working tree is a realistic accident. The secret detectors in
# `src/federation.ts` and `src/materialization.ts` only run on specific data paths,
# so they are not a substitute for this.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc
.netrc
credentials.json
credentials.yaml
credentials.yml

