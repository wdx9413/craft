{
  "name": "@craft/capability-datasec",
  "version": "0.1.2",
  "private": true,
  "description": "Independent local text redaction hooks for Claude Code and Codex",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types build.ts",
    "test": "node --experimental-strip-types --test ../../tests/craft-datasec.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "coverage": "cd ../.. && c8 --all --src=capability/craft-datasec --src=bin --src=core --include=core/release-catalog.ts --include=capability/craft-datasec/rules.ts --include=capability/craft-datasec/vault.ts --include=capability/craft-datasec/hook.ts --include=capability/craft-datasec/build.ts --include=bin/craft-datasec-hook.ts --reporter=text --reporter=json --reports-dir=coverage/craft-datasec --check-coverage --lines=100 --branches=100 --functions=100 node --experimental-strip-types --test tests/craft-datasec.test.ts"
  },
  "engines": {
    "node": ">=23"
  }
}
