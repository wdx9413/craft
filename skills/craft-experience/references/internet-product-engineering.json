{
  "nodes": [
    {
      "id": "requirement",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "request"
      ],
      "provides": [
        "spec"
      ],
      "acceptance_ref": "requirement-contract",
      "instruction": "澄清互联网产品需求、用户目标、边界与验收，输出已确认规格和未决问题。"
    },
    {
      "id": "diagnose",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "request"
      ],
      "provides": [
        "spec"
      ],
      "acceptance_ref": "diagnose-contract",
      "instruction": "核对复现与日志证据，定位根因；未复现或原因未证实时明确记录，输出诊断与修复边界。"
    },
    {
      "id": "implement",
      "type": "action",
      "side_effect": "local_write",
      "requires": [
        "spec"
      ],
      "provides": [
        "diff"
      ],
      "acceptance_ref": "implement-contract",
      "instruction": "按规格实现最小变更，记录变更范围、工作区修订和 diff；不部署或对外发布。"
    },
    {
      "id": "test",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "diff"
      ],
      "provides": [
        "tests"
      ],
      "acceptance_ref": "test-contract",
      "instruction": "针对当前 diff 执行相关验证，记录命令、退出码和覆盖范围；失败保留证据并走返工边。"
    },
    {
      "id": "review",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "diff",
        "tests"
      ],
      "provides": [
        "report"
      ],
      "acceptance_ref": "review-contract",
      "instruction": "审查当前 diff 与测试证据，输出 findings；区分发现问题与交付完成。"
    },
    {
      "id": "delivery",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "diff",
        "tests",
        "report"
      ],
      "provides": [],
      "acceptance_ref": "delivery-contract",
      "instruction": "确认当前 diff、测试、评审属于本轮有效产物，整理交付与未验证风险。交付就绪不表示已部署。"
    },
    {
      "id": "diagnosed",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "spec"
      ],
      "provides": [],
      "acceptance_ref": "diagnosed-contract",
      "instruction": "交付有依据的诊断报告，明确事实、假设与未决问题，不把报告完成解释为根因已确认。"
    },
    {
      "id": "reviewed",
      "type": "action",
      "side_effect": "read_only",
      "requires": [
        "report"
      ],
      "provides": [],
      "acceptance_ref": "reviewed-contract",
      "instruction": "交付针对给定 diff 的评审结果，不把评审完成解释为问题已修复。"
    }
  ],
