# Craft 模型接入配置模板（提交到 git；真实密钥不要写进本文件）
#
# 用法：
#   1. 复制为 .env.local（已被 .gitignore 忽略，不会进 git）
#   2. 填入真实 OPENAI_API_KEY
#   3. 用 `pnpm run eval:local` 或 `node --import ./scripts/dev/load-env.ts ...` 运行
#
# 仓库的安全约定：密钥只通过环境变量引用（api_key_env），不写进源码或
# settings.json；secret detector 会拦截源码里的凭据形状字符串。

# --- 本地 OpenAI 兼容网关（craft-eval / 模型驱动能力）---
# craft-eval/model.ts 读取这些变量重定向评测网关。
CRAFT_EVAL_PROVIDER=local-openai
CRAFT_EVAL_LABEL=Local OpenAI Gateway
CRAFT_EVAL_BASE_URL=http://127.0.0.1:3425/v1
CRAFT_EVAL_MODEL=group/free
CRAFT_EVAL_FRONTIER_MODEL=group/free
# 指向下面的 OPENAI_API_KEY 变量名，而不是把密钥本身写在这里。
CRAFT_EVAL_API_KEY_ENV=OPENAI_API_KEY

# --- 凭据（真实值只放 .env.local）---
OPENAI_BASE_URL=http://127.0.0.1:3425/v1
OPENAI_API_KEY=replace-with-your-real-key
