{
  "description": "Record content-free verified local coding observations for Craft Experience.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member experience", "timeout": 3, "statusMessage": "Checking Craft Experience lifecycle" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member experience", "timeout": 3, "statusMessage": "Loading scoped Craft Experience" }] }],
    "PostToolUse": [{ "matcher": "Bash|^apply_patch$|Edit|Write", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member experience", "timeout": 3, "statusMessage": "Recording verified Craft Experience signals" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member experience", "timeout": 3, "statusMessage": "Finalizing verified Craft Experience" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member experience", "timeout": 3, "statusMessage": "Closing Craft Experience session" }] }]
  }
}
