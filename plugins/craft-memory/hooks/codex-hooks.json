    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member memory", "timeout": 3, "statusMessage": "Closing Craft Memory turn" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs\" --member memory", "timeout": 3, "statusMessage": "Closing Craft Memory session" }] }]
  }
