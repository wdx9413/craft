{
  "name": "craft-context",
  "version": "0.21.10",
  "description": "Complete Knowledge, Memory, Experience, and Codebase tools in one Craft entry point",
  "author": {
    "name": "wdx9413"
  },
  "skills": "./skills/",
  "mcpServers": {
    "craft-context": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/plugin/craft-mcp.cjs",
        "--product",
        "context"
      ],
      "env": {
        "CRAFT_LEARNING_MODEL_HOST": "claude-code",
        "CRAFT_CONTEXT_MEMBERS": "knowledge,memory,experience,codebase,notes,eval,runtime"
      }
    }
  },
  "hooks": "./hooks/hooks.json"
}
