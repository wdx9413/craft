{
  "description": "Inject bounded reviewed Craft Knowledge for the current project only.",
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node ${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs --member knowledge",
        "timeout": 3,
        "statusMessage": "Checking Craft Knowledge lifecycle"
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node ${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs --member knowledge",
        "timeout": 3,
        "statusMessage": "Resolving scoped Craft Knowledge",
        "additionalContextLimit": 3200
      }, {
        "type": "mcp_tool",
        "server": "craft-knowledge",
        "tool": "craft_knowledge_search",
        "input": { "query": "${prompt}", "limit": 6 },
        "timeout": 3,
        "statusMessage": "Calling Craft Knowledge MCP"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node ${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs --member knowledge",
        "timeout": 3,
        "statusMessage": "Closing Craft Knowledge turn"
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "node ${PLUGIN_ROOT}/dist/plugin/craft-codex-hook.cjs --member knowledge",
        "timeout": 3,
        "statusMessage": "Closing Craft Knowledge session"
      }]
    }]
  }
}
